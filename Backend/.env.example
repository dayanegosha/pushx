# Edge secrets only. Never copy this material into the iOS target or commit .env.
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
APPLE_CLIENT_ID=com.yourcompany.forma
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
# Set to the entire PKCS#8 .p8 PEM. Literal \n is also supported by the handler.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ON_SERVER\n-----END PRIVATE KEY-----"
# Native iOS sends no Origin. Empty means all browser origins are denied.
ALLOWED_ORIGINS=
